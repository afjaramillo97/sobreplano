        },
        "600": {
          "$value": "#5245ED",
          "$description": "Kit loose color (POPULAR fold). Hover and text on soft purple fills: 4.99:1 on purple.94."
        },
        "90": {
          "$value": "#D8D6F5"
        },
        "92": {
          "$value": "#E0DEF7"
