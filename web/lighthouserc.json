{
  "ci": {
    "collect": {
      "startServerCommand": "node_modules/.bin/astro preview --port 4321 --ignore-lock",
      "startServerReadyPattern": "4321",
      "url": [
        "http://localhost:4321/",
        "http://localhost:4321/proyectos/",
        "http://localhost:4321/proyectos/mirador-de-los-guaduales/",
        "http://localhost:4321/asesor/",
        "http://localhost:4321/calculadora/",
        "http://localhost:4321/comparar/?p=altos-de-niquia,torres-del-ancon,mirador-de-los-guaduales"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
