        "properties": {
          "developer": {
            "$ref": "#/components/schemas/DeveloperOut"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LocationOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "municipality": {
            "$ref": "#/components/schemas/Municipality"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "neighborhood": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Neighborhood"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "source_url": {
            "title": "Source Url",
            "type": "string"
          },
          "unit_types": {
            "items": {
              "$ref": "#/components/schemas/UnitTypeOut"
            },
            "title": "Unit Types",
            "type": "array"
          }
        },
        "required": [
          "id",
          "slug",
          "name",
          "developer",
          "municipality",
          "neighborhood",
          "location",
          "source_url",
          "unit_types"
        ],
        "title": "ProjectOut",
        "type": "object"
      },
      "ProjectSort": {
        "description": "Order of a project listing.",
        "enum": [
          "name",
          "price"
        ],
        "title": "ProjectSort",
        "type": "string"
      },
      "UnitTypeDetailOut": {
        "description": "A unit type with its whole price history, oldest first.",
        "properties": {
          "area_basis": {
            "$ref": "#/components/schemas/AreaBasis"
          },
          "bathrooms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bathrooms"
          },
          "bedrooms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bedrooms"
          },
          "built_area_m2": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Built Area M2"
          },
          "change_since_first_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Change Since First Pct"
          },
          "first_price": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PricePointOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/PricePointOut"
            },
            "title": "History",
            "type": "array"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "latest_price": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LatestPriceOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "price_per_m2_cop": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Price Per M2 Cop"
          },
          "private_area_m2": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Private Area M2"
          }
        },
        "required": [
          "id",
          "name",
          "private_area_m2",
          "built_area_m2",
          "bedrooms",
          "bathrooms",
          "latest_price",
          "first_price",
          "change_since_first_pct",
          "price_per_m2_cop",
