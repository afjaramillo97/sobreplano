              },
              {
                "type": "null"
              }
            ],
            "title": "Bathrooms"
          },
          "bedrooms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bedrooms"
          },
          "built_area_m2": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Built Area M2"
          },
          "change_since_first_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Change Since First Pct"
          },
          "first_price": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PricePointOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "latest_price": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LatestPriceOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "price_per_m2_cop": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Price Per M2 Cop"
          },
          "private_area_m2": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Private Area M2"
          }
        },
        "required": [
          "id",
          "name",
          "private_area_m2",
          "built_area_m2",
          "bedrooms",
          "bathrooms",
          "latest_price",
          "first_price",
          "change_since_first_pct",
          "price_per_m2_cop",
          "area_basis"
        ],
        "title": "UnitTypeOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
