# Local Supabase Postgres (supabase db start)
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
# Scraper extraction model, as provider:model (default openai:gpt-6-luna)
# EXTRACTION_MODEL=openai:gpt-6-luna
OPENAI_API_KEY=
# Advisor (SPEC 08); defaults shown
# ADVISOR_MODEL=openai:gpt-6-luna
# ADVISOR_REASONING_EFFORT=medium
# ADVISOR_DAILY_BUDGET_USD=0.20
# ADVISOR_MAX_TURNS=20
# Terraform (infra/), only on the machine that runs terraform; see docs/deploy.md.
# State bucket name (contains the account ID, so it is not in the repo):
# TF_STATE_BUCKET=
# Email for the error alarm and the monthly budget:
# TF_VAR_alert_email=
# Langfuse Cloud, project sobreplano (SPEC 09)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# Evals (SPEC 09), see docs/evals.md. OpenRouter key for the Qwen extraction candidate:
OPENROUTER_API_KEY=
# Isolated database of the advisor evals; must be local (default: sobreplano_evals on the local Postgres):
# EVAL_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/sobreplano_evals
# Judge of the advisor evals, as provider:model; it must not be the advisor's model:
# EVAL_JUDGE_MODEL=openai:gpt-6.1-terra
