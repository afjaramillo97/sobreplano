---
// The search (SPEC 11b): every project as a card, with filters kept in the URL. The island
// renders the whole catalog on the server, so the page works and is indexed without
// JavaScript; in the browser it reads the URL and filters in memory.
import SearchPage from "@/components/search/SearchPage";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { loadCatalog, sortByFrom } from "@/lib/catalog";
import { toSearchItem } from "@/lib/search";

const items = sortByFrom(await loadCatalog()).map(toSearchItem);
---

<BaseLayout
  title="Proyectos sobre plano"
  description="Todos los proyectos de vivienda nueva sobre plano que seguimos en el Valle de Aburrá, con su precio desde y cuánto ha cambiado. Filtra por municipio, precio y alcobas."
>
  <Fragment slot="head">
    <!-- Before the first paint: the filter controls show only with JavaScript, and a URL with
         filters shows skeletons until the island has read it (no flash of the full list). -->
    <script is:inline>
      document.documentElement.dataset.js = "";
      if (
        /[?&](?:q|municipio|constructora|precio_min|precio_max|alcobas|banos|area_min|area_max|orden|vista)=[^&]/.test(
          location.search,
        )
      ) {
        document.documentElement.dataset.searchPending = "";
      }
    </script>
  </Fragment>
  <SearchPage client:load items={items} />
</BaseLayout>
