---
// The kit's fact sheet (784 wide): the "desde" unit type's rooms and area, the number of unit
// types, and whether the project has a current price. The kit's "delivery" and "status" cells
// would need data the API does not have, so they are not invented (DESIGN.md, rule 5).
import { formatArea } from "@/lib/format";
import type { IconName } from "@/lib/icons";
import type { ProjectView } from "@/lib/projects";
import Icon from "./Icon";

interface Props {
  project: ProjectView;
}

const { project } = Astro.props;
const unit = project.from ?? project.unitTypes[0] ?? null;
const dash = "—";
const facts: { icon: IconName; label: string; value: string }[] = [
  { icon: "bed-outline", label: "Alcobas", value: unit?.bedrooms != null ? String(unit.bedrooms) : dash },
  { icon: "bath-outline", label: "Baños", value: unit?.bathrooms != null ? String(unit.bathrooms) : dash },
  {
    icon: "square-meters-outline",
    label: unit?.areaBasis === "built" ? "Área construida" : "Área privada",
    value: unit ? formatArea(unit.areaM2) : dash,
  },
  {
    icon: "properties-outline",
    label: "Tipologías",
    value: String(project.unitTypes.length),
  },
  {
    icon: "check-circle-outline",
    label: "Estado",
    value: project.from ? "Precio vigente" : "Sin precio publicado",
  },
];
---

<section aria-labelledby="ficha-titulo" class="flex flex-col gap-4">
  <h2 id="ficha-titulo" class="text-body-sm text-text-muted">
    {unit ? <>Ficha técnica de la tipología {unit.name}{project.from && ", la del precio desde"}</> : "Ficha técnica"}
  </h2>
  <dl
    class="grid grid-cols-2 gap-6 rounded-md border-(length:--border-width-default) border-border p-6 sm:grid-cols-3 xl:grid-cols-5"
  >
    {
      facts.map((fact) => (
        <div class="flex flex-col gap-2">
          <dt class="text-body text-text-muted">{fact.label}</dt>
          <dd class="flex items-center gap-2 text-body-lg font-bold text-text-primary">
            <Icon name={fact.icon} className="shrink-0 text-action" />
            {fact.value}
          </dd>
        </div>
      ))
    }
  </dl>
</section>
