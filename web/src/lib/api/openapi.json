{
  "components": {
    "schemas": {
      "AreaBasis": {
        "description": "Which area a price per m² is computed on.",
        "enum": [
          "private",
          "built"
        ],
        "title": "AreaBasis",
        "type": "string"
      },
      "ChatIn": {
        "description": "A user message; without thread_id it starts a new conversation.",
        "properties": {
          "message": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "thread_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Thread Id"
          }
        },
        "required": [
          "message"
        ],
        "title": "ChatIn",
        "type": "object"
      },
      "ChatOut": {
        "description": "The advisor's answer and the conversation to continue it in.",
        "properties": {
          "projects": {
            "items": {
              "type": "string"
            },
            "title": "Projects",
            "type": "array"
          },
          "reply": {
            "title": "Reply",
            "type": "string"
          },
          "thread_id": {
            "format": "uuid",
            "title": "Thread Id",
            "type": "string"
          },
          "tools_used": {
            "items": {
              "type": "string"
            },
            "title": "Tools Used",
            "type": "array"
          }
        },
        "required": [
          "thread_id",
          "reply",
          "tools_used",
          "projects"
        ],
        "title": "ChatOut",
        "type": "object"
      },
      "DeveloperOut": {
        "description": "Developer of a project.",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          }
        },
        "required": [
          "name",
          "slug"
        ],
        "title": "DeveloperOut",
        "type": "object"
      },
      "DeveloperSummaryOut": {
        "description": "A developer with its number of projects.",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "projects": {
            "title": "Projects",
            "type": "integer"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "website_url": {
            "title": "Website Url",
            "type": "string"
          }
        },
        "required": [
          "slug",
          "name",
          "website_url",
          "projects"
        ],
        "title": "DeveloperSummaryOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Health status; database tells whether SELECT 1 answered.",
        "properties": {
          "database": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Database",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
