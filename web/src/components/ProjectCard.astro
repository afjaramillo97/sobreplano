---
// The kit's large project card (352 wide, 200 high image). The whole card is one link, with
// one focus stop. "Desde" always comes with its unit type and its date (rule 6).
import { formatArea, formatCount, formatDate, formatMillions } from "@/lib/format";
import { MUNICIPALITY_NAMES, type ProjectView } from "@/lib/projects";
import Icon from "./Icon.astro";
import PriceChangeBadge from "./PriceChangeBadge.astro";
import ProjectImage from "./ProjectImage.astro";

interface Props {
  project: ProjectView;
  /** For the first card on screen: its image loads eagerly. */
  priority?: boolean;
  /** Heading level of the project name, so the page outline stays in order. */
  headingLevel?: 2 | 3;
}

const { project, priority = false, headingLevel = 2 } = Astro.props;
const { from } = project;
const Heading = `h${headingLevel}` as "h2" | "h3";
const place = [MUNICIPALITY_NAMES[project.municipality], project.neighborhood]
  .filter(Boolean)
  .join(", ");
---

<a
  href={`/proyectos/${project.slug}/`}
  class="group relative flex h-full flex-col rounded-md border-(length:--border-width-default) border-border bg-bg-surface transition-colors duration-(--duration-fast) ease-out hover:border-border-input"
>
  <div class="relative">
    <ProjectImage class="aspect-[352/200] rounded-t-md" priority={priority} />
    {
      from?.changePct != null && (
        <PriceChangeBadge changePct={from.changePct} ribbon class="absolute -bottom-3 -left-2" />
      )
    }
  </div>
  <div class="flex flex-1 flex-col gap-2 p-6">
    {
      from?.priceCop != null ? (
        <p class="flex items-baseline gap-1">
          <span class="text-body text-text-muted">desde</span>
          <span class="text-price-lg text-text-price">{formatMillions(from.priceCop)}</span>
        </p>
      ) : (
        <p class="text-label text-text-secondary">Sin precio publicado</p>
      )
    }
    <Heading class="text-h3 text-text-primary">{project.name}</Heading>
    <p class="text-body font-medium text-text-muted">
      {project.developer.name} · {place}
    </p>
    {
      from && (
        <div class="mt-auto pt-4">
          <hr class="mb-4 border-t-(length:--border-width-default) border-border" />
          <ul class="flex flex-wrap items-center gap-x-4 gap-y-2 text-body-sm text-text-secondary">
            <li class="w-full">
              {from.name}, precio del {from.observedOn && formatDate(from.observedOn)}
            </li>
            {from.bedrooms != null && (
              <li class="inline-flex items-center gap-2">
                <Icon name="bed-outline" size={20} class="text-action" />
                {formatCount(from.bedrooms, "alcoba", "alcobas")}
              </li>
            )}
            {from.bathrooms != null && (
              <li class="inline-flex items-center gap-2">
                <Icon name="bath-outline" size={20} class="text-action" />
                {formatCount(from.bathrooms, "baño", "baños")}
              </li>
            )}
            <li class="inline-flex items-center gap-2">
              <Icon name="square-meters-outline" size={20} class="text-action" />
              {formatArea(from.areaM2)}
              <span class="sr-only">
                {from.areaBasis === "private" ? "de área privada" : "de área construida"}
              </span>
            </li>
          </ul>
        </div>
      )
    }
  </div>
</a>
