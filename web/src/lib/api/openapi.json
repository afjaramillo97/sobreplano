      }
    }
  },
  "info": {
    "title": "Sobreplano",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/advisor/chat": {
      "post": {
        "description": "Answer one message with Sobreplano's data.\n\nCommits the conversation and the token log, also before the 503 for too many tool\nrounds, so the spend is not lost.",
        "operationId": "chat_advisor_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Chat",
        "tags": [
          "advisor"
        ]
      }
    },
    "/advisor/chat/stream": {
      "post": {
        "description": "Answer one message as Server-Sent Events, telling each tool as it starts and ends.\n\nEvents: `step` (StepOut) when a tool starts or ends, then one `answer` (StreamAnswerOut)\nor one `error` (StreamErrorOut). The answer is the verified text, never partial text.\nWhat is known before the turn (422, 429, 404, 409, 503) is a plain HTTP answer, as in\nPOST /advisor/chat.\n\nThe turn runs in a thread with its own session and commits the conversation and the\ntoken log, also after too many tool rounds. If the client goes away or the stream\ntimes out, the turn still ends and is recorded.",
        "operationId": "chat_stream_advisor_chat_stream_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "itemSchema": {
                  "properties": {
                    "data": {
                      "type": "string"
                    },
                    "event": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "retry": {
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Chat Stream",
        "tags": [
          "advisor"
        ]
      }
    },
    "/developers": {
      "get": {
        "description": "List developers ordered by name; the slug is what `GET /projects?developer=` takes.",
        "operationId": "list_developers_developers_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DeveloperSummaryOut"
                  },
                  "title": "Response List Developers Developers Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Developers",
        "tags": [
          "developers"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Return 200 if the database answers SELECT 1, else 503 with the same body shape.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/projects": {
      "get": {
        "description": "Search projects; one unit type must meet every price, bedroom and area filter at once.\n\nEach project carries only the unit types that meet them. A bad value, an unknown\nmunicipality, or a minimum above its maximum gives 422.",
        "operationId": "list_projects_projects_get",
        "parameters": [
          {
            "in": "query",
            "name": "municipality",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Municipality"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Municipality"
            }
          },
          {
            "description": "Developer slug; unknown gives []",
            "in": "query",
            "name": "developer",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Developer slug; unknown gives []",
              "title": "Developer"
            }
          },
          {
            "description": "COP, latest price",
            "in": "query",
            "name": "min_price",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "COP, latest price",
              "title": "Min Price"
            }
          },
          {
            "description": "COP, latest price",
            "in": "query",
            "name": "max_price",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "COP, latest price",
              "title": "Max Price"
            }
          },
          {
            "in": "query",
            "name": "min_bedrooms",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Min Bedrooms"
            }
          },
          {
            "description": "m², private else built",
            "in": "query",
            "name": "min_area",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0.0,
                  "type": "number"
                },
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "m², private else built",
              "title": "Min Area"
            }
          },
          {
            "description": "m², private else built",
            "in": "query",
            "name": "max_area",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0.0,
                  "type": "number"
                },
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "m², private else built",
              "title": "Max Area"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/ProjectSort",
              "default": "name"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 50,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "maximum": 1000,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
